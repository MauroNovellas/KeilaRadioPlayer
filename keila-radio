#!/usr/bin/env bash

set -uo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_FAVORITES_FILE="$BASE_DIR/defaults/favorites"

# shellcheck source=lib/deps.sh
source "$BASE_DIR/lib/deps.sh"
# shellcheck source=lib/config.sh
source "$BASE_DIR/lib/config.sh"
# shellcheck source=lib/lock.sh
source "$BASE_DIR/lib/lock.sh"
# shellcheck source=lib/state.sh
source "$BASE_DIR/lib/state.sh"
# shellcheck source=lib/favorites.sh
source "$BASE_DIR/lib/favorites.sh"
# shellcheck source=lib/stations.sh
source "$BASE_DIR/lib/stations.sh"
# shellcheck source=lib/player.sh
source "$BASE_DIR/lib/player.sh"
# shellcheck source=lib/recording.sh
source "$BASE_DIR/lib/recording.sh"
# shellcheck source=lib/input.sh
source "$BASE_DIR/lib/input.sh"
# shellcheck source=lib/ui.sh
source "$BASE_DIR/lib/ui.sh"

cleanup() {
    recording_stop >/dev/null 2>&1 || true
    input_shutdown >/dev/null 2>&1 || true
    player_stop >/dev/null 2>&1 || true
    ui_leave >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

app_message() {
    ui_set_message "$1" "${2:-5}"
}

save_player_state() {
    STATE_VOLUME="$PLAYER_VOLUME"

    if [[ -n "${PLAYER_URL:-}" ]]; then
        STATE_LAST_NAME="$PLAYER_NAME"
        STATE_LAST_URL="$PLAYER_URL"
    fi

    state_save
}

app_init_data() {
    if ! config_load "$BASE_DIR/grabaciones"; then
        printf 'No se pudo cargar la configuración: %s\n' "$KEILA_CONFIG_FILE" >&2
        return 1
    fi

    favorites_init "$DEFAULT_FAVORITES_FILE" || {
        printf 'No se pudo inicializar favoritos: %s\n' "$KEILA_FAVORITES_FILE" >&2
        return 1
    }
    favorites_load || return 1
    state_load || return 1

    if ! recording_init "$KEILA_RECORDINGS_DIR"; then
        printf 'No se pudo crear la carpeta de grabaciones: %s\n' "$KEILA_RECORDINGS_DIR" >&2
        return 1
    fi

    PLAYER_VOLUME="$STATE_VOLUME"
    PLAYER_INFO_INTERVAL="$KEILA_PLAYER_INFO_INTERVAL"
}

app_play() {
    local name="$1"
    local url="$2"

    if ((RECORDING_ACTIVE)); then
        recording_stop >/dev/null 2>&1 || true
    fi

    if ! player_start "$name" "$url"; then
        if [[ -n "${PLAYER_LAST_EXIT_STATUS:-}" ]]; then
            app_message "No se pudo iniciar $name (mpv: código $PLAYER_LAST_EXIT_STATUS)." 8
        else
            app_message "No se pudo iniciar la emisora: $name" 8
        fi
        return 1
    fi

    save_player_state >/dev/null 2>&1 || true
    app_message "Conectando: $name" 5
    return 0
}

app_play_selected() {
    favorites_load
    ui_sync_selection

    if ((${#FAVORITE_NAMES[@]} == 0)); then
        app_message "No tienes favoritos. Pulsa B para buscar una emisora." 6
        return 1
    fi

    local name="${FAVORITE_NAMES[$UI_SELECTED_INDEX]}"
    local url="${FAVORITE_URLS[$UI_SELECTED_INDEX]}"
    app_play "$name" "$url"
}

app_change_volume() {
    local delta="$1"

    if player_change_volume "$delta"; then
        if save_player_state >/dev/null 2>&1; then
            app_message "Volumen: ${PLAYER_VOLUME}%" 2
        else
            app_message "Volumen: ${PLAYER_VOLUME}% (no se pudo guardar el estado)." 7
        fi
    else
        app_message "No se pudo cambiar el volumen." 6
    fi
}

app_toggle_pause() {
    if ! player_is_running; then
        app_message "No hay ninguna emisora en reproducción." 5
        return 1
    fi

    if player_toggle_pause; then
        if ((PLAYER_PAUSED)); then
            app_message "Reproducción pausada." 3
        else
            app_message "Reproducción reanudada." 3
        fi
    else
        app_message "No se pudo cambiar la pausa." 6
        return 1
    fi
}

app_toggle_recording() {
    if ((RECORDING_ACTIVE)); then
        local saved_file
        saved_file=$(recording_filename)

        if recording_stop; then
            local saved_size
            saved_size=$(recording_size_human)

            if [[ -n "${RECORDING_LAST_ERROR:-}" ]]; then
                app_message "Grabación conservada: $saved_file ($saved_size)." 8
            else
                app_message "Grabación guardada: $saved_file ($saved_size)." 8
            fi
            return 0
        fi

        app_message "Grabación no válida: ${RECORDING_LAST_ERROR:-error desconocido}" 9
        return 1
    fi

    if ! player_is_running; then
        app_message "No hay ninguna emisora en reproducción para grabar." 6
        return 1
    fi

    if recording_start "$PLAYER_NAME"; then
        app_message "Grabando: $(recording_filename)" 4
        return 0
    fi

    app_message "No se pudo iniciar la grabación." 7
    return 1
}

app_toggle_favorite() {
    if ! player_is_running; then
        app_message "No hay ninguna emisora en reproducción." 5
        return 1
    fi

    favorites_load

    if ! favorites_toggle "$PLAYER_NAME" "$PLAYER_URL"; then
        app_message "No se pudo modificar favoritos." 6
        return 1
    fi

    case "${FAVORITES_TOGGLE_ACTION:-}" in
        added)
            app_message "Añadida a favoritos: $PLAYER_NAME" 5
            ui_select_url "$PLAYER_URL" >/dev/null 2>&1 || true
            ;;
        removed)
            app_message "Eliminada de favoritos: $PLAYER_NAME" 5
            ui_sync_selection
            ;;
    esac
}

app_move_selected_favorite() {
    local delta="$1"

    favorites_load
    ui_sync_selection

    local count=${#FAVORITE_NAMES[@]}
    if ((count == 0)); then
        app_message "No tienes favoritos para reordenar." 5
        return 1
    fi

    local index=$UI_SELECTED_INDEX
    local target=$((index + delta))
    local name="${FAVORITE_NAMES[$index]}"

    if ((target < 0 || target >= count)); then
        if ((delta < 0)); then
            app_message "Ese favorito ya está arriba del todo." 4
        else
            app_message "Ese favorito ya está abajo del todo." 4
        fi
        return 1
    fi

    if favorites_move "$index" "$delta"; then
        favorites_load
        ui_select_url "${FAVORITE_URLS[$target]:-}" >/dev/null 2>&1 || true
        app_message "Nuevo orden guardado: $name" 4
        return 0
    fi

    app_message "No se pudo reordenar el favorito." 6
    return 1
}

app_remove_selected_favorite() {
    favorites_load
    ui_sync_selection

    if ((${#FAVORITE_NAMES[@]} == 0)); then
        app_message "No tienes favoritos para eliminar." 5
        return 1
    fi

    local index=$UI_SELECTED_INDEX
    local name="${FAVORITE_NAMES[$index]}"
    local url="${FAVORITE_URLS[$index]}"

    if ! favorites_remove_index "$index"; then
        app_message "No se pudo eliminar el favorito." 6
        return 1
    fi

    ui_sync_selection

    if player_is_running && [[ "$PLAYER_URL" == "$url" ]]; then
        app_message "Quitada de favoritos; sigue sonando: $name" 5
    else
        app_message "Favorito eliminado: $name" 5
    fi
}

app_search_catalog() {
    ui_suspend

    local status=0
    stations_select_fzf || status=$?

    ui_resume

    if ((status != 0)); then
        app_message "Búsqueda cancelada." 3
        return 0
    fi

    app_play "$SELECTED_NAME" "$SELECTED_URL"
}

app_update_catalog() {
    ui_suspend

    local status=0
    stations_update_catalog || status=$?

    ui_resume

    if ((status == 0)); then
        app_message "Catálogo de TDTChannels actualizado." 5
    else
        app_message "No se pudo actualizar el catálogo." 7
    fi
}

app_poll_player() {
    if [[ -n "${PLAYER_PID:-}" ]] && ! player_is_running; then
        local was_recording=$RECORDING_ACTIVE
        local exit_status='?'

        if player_collect_exit_status; then
            exit_status="${PLAYER_LAST_EXIT_STATUS:-?}"
        fi

        if ((was_recording)); then
            local saved_file
            saved_file=$(recording_filename)

            if recording_finalize_after_player_exit; then
                app_message "mpv se detuvo; grabación recuperada: $saved_file ($(recording_size_human))." 9
            else
                app_message "mpv se detuvo (código $exit_status) y la grabación quedó incompleta." 9
            fi
        else
            app_message "La reproducción se detuvo inesperadamente (mpv: código $exit_status)." 9
        fi
        return 0
    fi

    player_is_running || return 1

    local changed=1
    local was_ready=$PLAYER_INFO_READY
    local was_buffering=$PLAYER_BUFFERING

    if player_refresh_info; then
        if ((!was_ready && PLAYER_INFO_READY)); then
            app_message "Reproduciendo: $PLAYER_NAME" 3
        elif ((!was_buffering && PLAYER_BUFFERING)); then
            app_message "Esperando datos del stream..." 5
        elif ((was_buffering && !PLAYER_BUFFERING && PLAYER_INFO_READY)); then
            app_message "Reproducción reanudada." 3
        fi
        changed=0
    fi

    if recording_tick_changed; then
        changed=0
    fi

    return "$changed"
}

app_handle_key() {
    local key="$1"

    case "$key" in
        w|W) ui_move_selection -1 || true ;;
        s|S) ui_move_selection 1 || true ;;
        a|A) app_change_volume "$((-KEILA_VOLUME_STEP))" ;;
        d|D) app_change_volume "$KEILA_VOLUME_STEP" ;;
        p|P) app_toggle_pause || true ;;
        r|R) app_toggle_recording || true ;;
        f|F) app_toggle_favorite || true ;;
        j|J) app_move_selected_favorite 1 || true ;;
        k|K) app_move_selected_favorite -1 || true ;;
        x|X) app_remove_selected_favorite || true ;;
        b|B) app_search_catalog || true ;;
        u|U) app_update_catalog || true ;;
        h|H) ui_toggle_help ;;
        q|Q)
            app_message "Hasta luego." 0
            return 2
            ;;
        *) return 1 ;;
    esac

    return 0
}

app_loop() {
    input_init
    ui_enter
    ui_draw

    while true; do
        if ! input_read; then
            return 0
        fi

        local redraw=0

        case "$INPUT_EVENT" in
            TICK)
                app_poll_player && redraw=1
                ui_message_tick && redraw=1
                ;;
            RESIZE) redraw=1 ;;
            ESC)
                if ((UI_HELP_VISIBLE)); then
                    ui_toggle_help
                    redraw=1
                fi
                ;;
            UP) ui_move_selection -1 || true; redraw=1 ;;
            DOWN) ui_move_selection 1 || true; redraw=1 ;;
            LEFT) app_change_volume "$((-KEILA_VOLUME_STEP))"; redraw=1 ;;
            RIGHT) app_change_volume "$KEILA_VOLUME_STEP"; redraw=1 ;;
            HOME) ui_select_first || true; redraw=1 ;;
            END) ui_select_last || true; redraw=1 ;;
            PAGE_UP) ui_move_selection -5 || true; redraw=1 ;;
            PAGE_DOWN) ui_move_selection 5 || true; redraw=1 ;;
            ENTER) app_play_selected || true; redraw=1 ;;
            KEY)
                app_handle_key "$INPUT_KEY"
                local key_status=$?

                if ((key_status == 2)); then
                    ui_draw
                    return 0
                elif ((key_status == 0)); then
                    redraw=1
                fi
                ;;
        esac

        ((redraw)) && ui_draw
    done
}

main() {
    # --check valida inicialización/rutas/escritura sin abrir TUI, red ni mpv.
    if [[ "${1:-}" == '--check' ]]; then
        app_init_data || return 1
        printf 'Keila Radio Player: inicialización OK\n'
        printf 'Configuración: %s\n' "$KEILA_CONFIG_FILE"
        printf 'Favoritos: %s\n' "$KEILA_FAVORITES_FILE"
        printf 'Estado: %s\n' "$KEILA_STATE_FILE"
        printf 'Grabaciones: %s\n' "$KEILA_RECORDINGS_DIR"
        return 0
    fi

    deps_ensure || exit 1
    app_init_data || exit 1

    player_require_dependencies || exit 1
    ui_require_dependencies || exit 1

    ui_select_url "$STATE_LAST_URL" >/dev/null 2>&1 || true

    local station_url="${1:-}"
    local station_name="${2:-Stream de prueba}"

    if [[ -n "$station_url" ]]; then
        app_play "$station_name" "$station_url" || die "No se pudo iniciar mpv"
    elif [[ -n "$STATE_LAST_NAME" ]]; then
        app_message "Última emisora: $STATE_LAST_NAME" 7
    else
        app_message "W/S o flechas para elegir un favorito; B busca en TDTChannels." 8
    fi

    app_loop
}

main "$@"
