#!/usr/bin/env bash

set -uo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LEGACY_FAVORITES_FILE="$BASE_DIR/emisorasFavoritas.txt"

# shellcheck source=lib/config.sh
source "$BASE_DIR/lib/config.sh"
# shellcheck source=lib/state.sh
source "$BASE_DIR/lib/state.sh"
# shellcheck source=lib/favorites.sh
source "$BASE_DIR/lib/favorites.sh"
# shellcheck source=lib/stations.sh
source "$BASE_DIR/lib/stations.sh"
# shellcheck source=lib/player.sh
source "$BASE_DIR/lib/player.sh"

cleanup() {
    player_stop >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

print_favorites() {
    printf '\nFavoritos\n\n'

    if ((${#FAVORITE_NAMES[@]} == 0)); then
        printf '  (no tienes favoritos guardados)\n'
        return 0
    fi

    local i
    for ((i = 0; i < ${#FAVORITE_NAMES[@]}; i++)); do
        if [[ -n "$STATE_LAST_URL" && "${FAVORITE_URLS[$i]}" == "$STATE_LAST_URL" ]]; then
            printf '  %2d) %s  [última]\n' "$((i + 1))" "${FAVORITE_NAMES[$i]}"
        else
            printf '  %2d) %s\n' "$((i + 1))" "${FAVORITE_NAMES[$i]}"
        fi
    done
}

choose_favorite() {
    local input action number index

    while true; do
        favorites_load
        print_favorites
        printf '\n'
        printf 'Número = reproducir · d N = eliminar · k N = subir · j N = bajar · q = volver\n'
        read -r -p 'Favoritos > ' input || return 1

        [[ "$input" =~ ^[qQ]$ ]] && return 1

        if [[ "$input" =~ ^[0-9]+$ ]]; then
            number="$input"
            if ((number < 1 || number > ${#FAVORITE_NAMES[@]})); then
                printf '\nSelección fuera de rango.\n'
                continue
            fi

            SELECTED_NAME="${FAVORITE_NAMES[$((number - 1))]}"
            SELECTED_URL="${FAVORITE_URLS[$((number - 1))]}"
            return 0
        fi

        read -r action number _ <<< "$input"
        [[ "$number" =~ ^[0-9]+$ ]] || {
            printf '\nComando no válido.\n'
            continue
        }

        index=$((number - 1))
        if ((index < 0 || index >= ${#FAVORITE_NAMES[@]})); then
            printf '\nSelección fuera de rango.\n'
            continue
        fi

        case "$action" in
            d|D)
                printf '\nEliminando: %s\n' "${FAVORITE_NAMES[$index]}"
                favorites_remove_index "$index" || printf 'No se pudo eliminar el favorito.\n' >&2
                ;;
            k|K)
                if favorites_move "$index" -1; then
                    printf '\nMovida arriba: %s\n' "${FAVORITE_NAMES[$((index - 1))]}"
                else
                    printf '\nEsa emisora ya está arriba del todo.\n'
                fi
                ;;
            j|J)
                if favorites_move "$index" 1; then
                    printf '\nMovida abajo: %s\n' "${FAVORITE_NAMES[$((index + 1))]}"
                else
                    printf '\nEsa emisora ya está abajo del todo.\n'
                fi
                ;;
            *)
                printf '\nComando no válido.\n'
                ;;
        esac
    done
}

choose_catalog_station() {
    if ! stations_select_fzf; then
        printf '\nBúsqueda cancelada o catálogo no disponible.\n'
        return 1
    fi

    printf '\nSeleccionada: %s' "$SELECTED_NAME"
    [[ -n "${SELECTED_AMBIT:-}" ]] && printf ' · %s' "$SELECTED_AMBIT"
    [[ -n "${SELECTED_FORMAT:-}" ]] && printf ' · %s' "$SELECTED_FORMAT"
    printf '\n'
}

resume_last_station() {
    [[ -n "$STATE_LAST_URL" ]] || return 1

    SELECTED_NAME="${STATE_LAST_NAME:-Última emisora}"
    SELECTED_URL="$STATE_LAST_URL"
}

show_start_menu() {
    printf '\nKeila Radio Player v2\n\n'

    if [[ -n "$STATE_LAST_URL" ]]; then
        printf '  Enter) Reanudar: %s\n' "${STATE_LAST_NAME:-Última emisora}"
    fi

    printf '  b) Buscar en TDTChannels\n'
    printf '  f) Favoritos / gestionar favoritos\n'
    printf '  u) Actualizar catálogo\n'
    printf '  q) Salir\n\n'
}

choose_station() {
    local choice

    while true; do
        show_start_menu
        read -r -p 'Opción: ' choice || return 2

        if [[ -z "$choice" && -n "$STATE_LAST_URL" ]]; then
            resume_last_station && return 0
        fi

        case "$choice" in
            b|B)
                choose_catalog_station && return 0
                ;;
            f|F)
                choose_favorite && return 0
                ;;
            u|U)
                printf '\n'
                if stations_update_catalog; then
                    printf '\n'
                else
                    printf '\nNo se pudo actualizar el catálogo.\n\n' >&2
                fi
                ;;
            q|Q)
                return 2
                ;;
            *)
                printf '\nOpción no válida.\n'
                ;;
        esac
    done
}

save_current_state() {
    STATE_VOLUME="$PLAYER_VOLUME"
    STATE_LAST_NAME="$PLAYER_NAME"
    STATE_LAST_URL="$PLAYER_URL"

    if ! state_save; then
        printf '\nAviso: no se pudo guardar el estado de Keila.\n' >&2
        return 1
    fi
}

show_favorite_status() {
    if favorites_find_url "$PLAYER_URL" >/dev/null; then
        printf 'Favorito: sí\n'
    else
        printf 'Favorito: no\n'
    fi
}

show_controls() {
    printf '\nReproduciendo: %s\n' "$PLAYER_NAME"
    printf 'Volumen: %s%%\n' "$PLAYER_VOLUME"
    show_favorite_status
    printf '\n[p] pausa   [a/d] volumen   [f] favorito   [q] salir\n'
}

toggle_current_favorite() {
    if ! favorites_toggle "$PLAYER_NAME" "$PLAYER_URL"; then
        printf '\nNo se pudo modificar favoritos.\n' >&2
        return 1
    fi

    case "${FAVORITES_TOGGLE_ACTION:-}" in
        added)
            printf '\nAñadida a favoritos: %s\n' "$PLAYER_NAME"
            ;;
        removed)
            printf '\nEliminada de favoritos: %s\n' "$PLAYER_NAME"
            ;;
    esac
}

interactive_loop() {
    local key

    while IFS= read -rsn1 key; do
        case "$key" in
            p|P)
                if player_toggle_pause; then
                    if ((PLAYER_PAUSED)); then
                        printf '\nPausado\n'
                    else
                        printf '\nReproduciendo\n'
                    fi
                fi
                ;;
            a|A)
                if player_change_volume -5; then
                    save_current_state >/dev/null || true
                    printf '\nVolumen: %s%%\n' "$PLAYER_VOLUME"
                fi
                ;;
            d|D)
                if player_change_volume 5; then
                    save_current_state >/dev/null || true
                    printf '\nVolumen: %s%%\n' "$PLAYER_VOLUME"
                fi
                ;;
            f|F)
                toggle_current_favorite || true
                ;;
            q|Q)
                printf '\nSaliendo de Keila...\n'
                return 0
                ;;
        esac

        if ! player_is_running; then
            printf '\nEl proceso de mpv ha terminado.\n' >&2
            return 1
        fi
    done
}

main() {
    keila_init_paths
    favorites_init "$LEGACY_FAVORITES_FILE"
    favorites_load
    state_load

    PLAYER_VOLUME="$STATE_VOLUME"

    player_require_dependencies || exit 1

    local station_url="${1:-}"
    local station_name="${2:-Stream de prueba}"

    if [[ -n "$station_url" ]]; then
        SELECTED_NAME="$station_name"
        SELECTED_URL="$station_url"
    else
        choose_station
        local choice_status=$?

        case "$choice_status" in
            0)
                ;;
            2)
                printf '\nHasta luego.\n'
                return 0
                ;;
            *)
                die "No se pudo seleccionar una emisora"
                ;;
        esac
    fi

    printf '\nConectando con %s...\n' "$SELECTED_NAME"

    if ! player_start "$SELECTED_NAME" "$SELECTED_URL"; then
        die "No se pudo iniciar mpv"
    fi

    save_current_state >/dev/null || true
    show_controls
    interactive_loop
}

main "$@"
