cleanup() {
    session_log_close >/dev/null 2>&1 || true
    pending_cleanup >/dev/null 2>&1 || true
    spectrum_stop >/dev/null 2>&1 || true
    catalog_stop >/dev/null 2>&1 || true
    recording_stop >/dev/null 2>&1 || true
    input_shutdown >/dev/null 2>&1 || true
    player_stop >/dev/null 2>&1 || true
    ui_leave >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
app_message() { ui_set_message "$1" "${2:-5}"; }

save_player_state() {
    STATE_VOLUME="$PLAYER_VOLUME"
    if [[ -n "${PLAYER_URL:-}" ]] && ((${PLAYER_STREAM_READY:-0})); then
        STATE_LAST_NAME="$PLAYER_NAME"
        STATE_LAST_URL="$PLAYER_URL"
    fi
    state_save
}

app_init_data() {
    keila_init_paths || return 1
    data_recover "$KEILA_FAVORITES_FILE" favorites || return 1
    data_recover "$KEILA_CONFIG_DIR/labels" labels || return 1
    data_recover "$KEILA_STATE_FILE" state || return 1
    data_recover "$KEILA_CONFIG_DIR/preferences" preferences || return 1
    if ! config_load "$BASE_DIR/grabaciones"; then
        printf 'No se pudo cargar la configuración: %s\n' "$KEILA_CONFIG_FILE" >&2
        return 1
    fi
    favorites_init "$DEFAULT_FAVORITES_FILE" || {
        printf 'No se pudo inicializar favoritos: %s\n' "$KEILA_FAVORITES_FILE" >&2
        return 1
    }
    favorites_load || return 1
    labels_load || return 1
    history_load || return 1
    equalizer_load || return 1
    state_load || return 1
    if ! recording_init "$KEILA_RECORDINGS_DIR"; then
        printf 'No se pudo crear la carpeta de grabaciones: %s\n' "$KEILA_RECORDINGS_DIR" >&2
        return 1
    fi
    PLAYER_VOLUME="$STATE_VOLUME"
    PLAYER_INFO_INTERVAL="$KEILA_PLAYER_INFO_INTERVAL"
    preferences_load
    preferences_apply
}

app_init_catalog_data() {
    keila_init_paths || return 1
    if ! config_load "$BASE_DIR/grabaciones"; then
        printf 'No se pudo cargar la configuración: %s\n' "$KEILA_CONFIG_FILE" >&2
        return 1
    fi
}

app_play() {
    local name="$1" url="$2"
    local recording_notice=""

    if ((RECORDING_ACTIVE)); then
        local saved_file saved_size recording_error
        saved_file=$(recording_filename)

        if ! recording_stop; then
            recording_error="${RECORDING_LAST_ERROR:-No se pudo validar el archivo.}"
            app_message "Grabación incompleta: $recording_error No se cambia de emisora." 9
            return 1
        fi

        saved_size=$(recording_size_human)
        if [[ -n "${RECORDING_LAST_ERROR:-}" ]]; then
            recording_notice="Grabación conservada: $saved_file ($saved_size)"
        else
            recording_notice="Grabación guardada: $saved_file ($saved_size)"
        fi
    fi

    if ! player_start "$name" "$url"; then
        local failure_reason="${PLAYER_FAILURE_REASON:-}"
        local failure_text='no se pudo abrir la conexión'
        if declare -F player_failure_description >/dev/null 2>&1 && [[ -n "$failure_reason" ]]; then
            failure_text=$(player_failure_description "$failure_reason")
        fi
        if [[ -n "${PLAYER_LAST_EXIT_STATUS:-}" ]]; then
            if [[ -n "$recording_notice" ]]; then
                app_message "$recording_notice · No se pudo iniciar $name (mpv: código $PLAYER_LAST_EXIT_STATUS)." 9
            else
                app_message "No se pudo iniciar $name: $failure_text (código $PLAYER_LAST_EXIT_STATUS)." 8
            fi
        else
            if [[ -n "$recording_notice" ]]; then
                app_message "$recording_notice · No se pudo iniciar la emisora: $name" 9
            else
                app_message "No se pudo iniciar $name: $failure_text." 8
            fi
        fi
        if [[ "$failure_reason" == startup_socket && "${PLAYER_URL:-}" == "$url" && -n "$url" && -n "${APP_RECONNECT_BASE_DELAY:-}" ]]; then
            APP_RECONNECT_ELIGIBLE=1
            APP_RECONNECT_ATTEMPTS=0
            APP_RECONNECT_WAITING=0
            APP_RECONNECT_NEXT_AT=$((${EPOCHSECONDS:-$(date +%s)} + APP_RECONNECT_BASE_DELAY))
            HISTORY_PENDING_URL=$url
            app_message "${recording_notice:+$recording_notice · }No se pudo conectar con $name. Reintento en ${APP_RECONNECT_BASE_DELAY}s; comprueba la red o prueba otra emisora." 8
        fi
        return 1
    fi

    track_history_start_station "$name" "$url"
    HISTORY_PENDING_URL="$url"
    save_player_state >/dev/null 2>&1 || true
    if [[ -n "$recording_notice" ]]; then
        app_message "$recording_notice · Conectando: $name" 8
    else
        app_message "Conectando: $name" 5
    fi
}

app_play_selected() {
    favorites_load
    ui_sync_selection
    if ((UI_NAV_COUNT == 0)); then app_message "No hay emisoras. Pulsa B para buscar." 6; return 1; fi
    if ((UI_SELECTED_INDEX < ${#FAVORITE_NAMES[@]})); then
        app_play "${FAVORITE_NAMES[$UI_SELECTED_INDEX]}" "${FAVORITE_URLS[$UI_SELECTED_INDEX]}"
    else
        local recent=$((UI_SELECTED_INDEX - ${#FAVORITE_NAMES[@]}))
        app_play "${RECENT_NAMES[recent]}" "${RECENT_URLS[recent]}"
    fi
}

# Los diez primeros elementos de la sección activa funcionan como presets de
# una radio física: 1..9 seleccionan las posiciones 1..9 y 0 la posición 10.
# No hay buffer ni combinaciones de varias cifras; el resto sigue accesible con
# cursores/W/S y búsqueda.
app_play_favorite_preset() {
    local key="$1" index
    case "$key" in
        [1-9]) index=$((key - 1)) ;;
        0) index=9 ;;
        *) return 1 ;;
    esac

    if ! favorites_load; then
        app_message "No se pudieron cargar favoritos." 6
        return 1
    fi
    ui_navigation_refresh
    local favorite_count=${#FAVORITE_NAMES[@]}
    if ((UI_SELECTED_INDEX >= favorite_count && UI_SELECTED_INDEX < favorite_count + ${#RECENT_NAMES[@]})); then
        if ((index >= ${#RECENT_NAMES[@]})); then
            app_message "No hay reciente asignado al preset $key." 4
            return 0
        fi
        UI_SELECTED_INDEX=$((favorite_count + index))
        ui_sync_selection
        app_play "${RECENT_NAMES[$index]}" "${RECENT_URLS[$index]}"
        return 0
    fi

    if ((index >= favorite_count)); then
        app_message "No hay favorito asignado al preset $key." 4
        return 0
    fi

    UI_SELECTED_INDEX=$index
    ui_sync_selection
    app_play "${FAVORITE_NAMES[$index]}" "${FAVORITE_URLS[$index]}"
}

app_change_volume() {
    local delta="$1"
    if player_change_volume "$delta"; then
        if save_player_state >/dev/null 2>&1; then
            app_message "Volumen: ${PLAYER_VOLUME}%" 2
        else
            app_message "Volumen: ${PLAYER_VOLUME}% (no se pudo guardar el estado)." 7
        fi
    else
        app_message "No se pudo cambiar el volumen." 6
    fi
}

app_toggle_spectrum() {
    local status=0
    spectrum_toggle || status=$?
    PREF_SPECTRUM=$SPECTRUM_ENABLED
    case "$status" in
        0)
            if ((SPECTRUM_ENABLED)); then app_message 'Analizador de espectro activado.' 4; else app_message 'Analizador de espectro oculto.' 4; fi
            ;;
        2) app_message "Analizador no disponible: ${SPECTRUM_ERROR:-comprueba PulseAudio/PipeWire}" 7 ;;
        *) app_message 'No se pudo cambiar el analizador de espectro.' 6 ;;
    esac
    preferences_save || app_message "${UI_MESSAGE:-Espectrograma actualizado.} · No se pudo guardar la preferencia." 9
}

app_toggle_pause() {
    if ! player_is_running; then app_message "No hay ninguna emisora en reproducción." 5; return 1; fi
    if player_toggle_pause; then
        if ((PLAYER_PAUSED)); then app_message "Reproducción pausada." 3; else app_message "Reproducción reanudada." 3; fi
    else
        app_message "No se pudo cambiar la pausa." 6
        return 1
    fi
}

app_toggle_recording() {
    if ((RECORDING_ACTIVE)); then
        local saved_file
        saved_file=$(recording_filename)
        local stop_status=0
        recording_stop || stop_status=$?
        if ((stop_status == 0)); then
            local saved_size
            saved_size=$(recording_size_human)
            if [[ -n "${RECORDING_LAST_ERROR:-}" ]]; then
                app_message "Grabación conservada: $saved_file ($saved_size)." 8
            else
                app_message "Grabación guardada: $saved_file ($saved_size)." 8
            fi
            return 0
        fi
        if ((stop_status == 2)); then
            app_message "${RECORDING_LAST_ERROR:-Cierre pendiente: esperando a mpv.}" 8
        else
            app_message "${RECORDING_LAST_ERROR:-No se pudo finalizar la grabación.}" 9
        fi
        return 1
    fi
    if ! player_is_running; then app_message "No hay ninguna emisora en reproducción para grabar." 6; return 1; fi
    if recording_start "$PLAYER_NAME"; then app_message "Preparando grabación: $(recording_filename)" 8; return 0; fi
    app_message "No se pudo iniciar la grabación." 7
    return 1
}

app_toggle_favorite() {
    if ! player_is_running; then app_message "No hay ninguna emisora en reproducción." 5; return 1; fi
    if ! favorites_load; then app_message "No se pudieron cargar favoritos." 6; return 1; fi

    FAVORITES_TOGGLE_ACTION=''
    local index confirm_status=0 action_status=0
    if index=$(favorites_find_url "$PLAYER_URL"); then
        favorites_confirm_removal 'playing' "$PLAYER_URL" || confirm_status=$?
        if ((confirm_status == 2)); then
            app_message "Pulsa X otra vez para eliminar de favoritas: $PLAYER_NAME" 4
            return 0
        fi
        if ((confirm_status != 0)); then
            app_message "No se pudo preparar la confirmación de eliminación." 6
            return 1
        fi

        if ! favorites_remove_index "$index"; then
            app_message "No se pudo eliminar de favoritos: $PLAYER_NAME" 6
            return 1
        fi
        FAVORITES_TOGGLE_ACTION='removed'
        ui_sync_selection
        app_message "Eliminada de favoritos: $PLAYER_NAME" 5
        return 0
    fi

    favorites_confirm_clear
    favorites_add "$PLAYER_NAME" "$PLAYER_URL" || action_status=$?
    case "$action_status" in
        0)
            FAVORITES_TOGGLE_ACTION='added'
            ui_select_url "$PLAYER_URL" >/dev/null 2>&1 || true
            app_message "Añadida a favoritos: $PLAYER_NAME" 5
            ;;
        2)
            favorites_load >/dev/null 2>&1 || true
            app_message "Ya estaba en favoritos: $PLAYER_NAME" 4
            ;;
        *)
            app_message "No se pudo añadir a favoritos: $PLAYER_NAME" 6
            return 1
            ;;
    esac
}

# X sobre Recientes gestiona exactamente esa emisora, incluso si no está sonando.
app_toggle_selected_recent_favorite() {
    local recent=$((UI_SELECTED_INDEX - ${#FAVORITE_NAMES[@]}))
    local name="${RECENT_NAMES[recent]:-}" url="${RECENT_URLS[recent]:-}"
    [[ -n "$url" ]] || return 1
    local index confirm_status=0
    if index=$(favorites_find_url "$url"); then
        favorites_confirm_removal 'recent' "$url" || confirm_status=$?
        if ((confirm_status == 2)); then app_message "Pulsa X otra vez para eliminar de favoritas: $name" 4; return 0; fi
        ((confirm_status == 0)) || return 1
        favorites_remove_index "$index" || return 1
        app_message "Eliminada de favoritas: $name" 5
    else
        favorites_confirm_clear
        favorites_add "$name" "$url" || return 1
        app_message "Añadida a favoritas: $name" 5
    fi
    history_recent_refresh
    UI_SELECTED_INDEX=$((${#FAVORITE_NAMES[@]} + recent))
    ui_sync_selection
}

app_move_selected_favorite() {
    local delta="$1"
    favorites_load
    ui_sync_selection
    local count=${#FAVORITE_NAMES[@]}
    if ((count == 0)); then app_message "No tienes favoritos para reordenar." 5; return 1; fi

    if ((UI_SELECTED_INDEX >= ${#FAVORITE_NAMES[@]})); then
        app_message 'Esta acción requiere seleccionar un favorito.' 4
        return 1
    fi
    local index=$UI_SELECTED_INDEX
    local target=$((index + delta))
    local name="${FAVORITE_NAMES[$index]}"
    local selected_url="${FAVORITE_URLS[$index]}"
    if ((target < 0 || target >= count)); then
        if ((delta < 0)); then app_message "Ese favorito ya está arriba del todo." 4; else app_message "Ese favorito ya está abajo del todo." 4; fi
        return 1
    fi

    if favorites_move "$index" "$delta"; then
        favorites_load
        ui_select_url "$selected_url" >/dev/null 2>&1 || ui_sync_selection
        app_message "Nuevo orden guardado: $name" 4
        return 0
    fi
    app_message "No se pudo reordenar el favorito." 6
    return 1
}

app_remove_selected_favorite() {
    if ! favorites_load; then app_message "No se pudieron cargar favoritos." 6; return 1; fi
    ui_sync_selection
    if ((${#FAVORITE_NAMES[@]} == 0)); then app_message "No tienes favoritos para eliminar." 5; return 1; fi

    if ((UI_SELECTED_INDEX >= ${#FAVORITE_NAMES[@]})); then
        app_message 'Esta acción requiere seleccionar un favorito.' 4
        return 1
    fi
    local index=$UI_SELECTED_INDEX
    local name="${FAVORITE_NAMES[$index]}"
    local url="${FAVORITE_URLS[$index]}"
    local confirm_status=0

    favorites_confirm_removal 'selected' "$url" || confirm_status=$?
    if ((confirm_status == 2)); then
        app_message "Pulsa X otra vez para eliminar el favorito: $name" 4
        return 0
    fi
    if ((confirm_status != 0)); then
        app_message "No se pudo preparar la confirmación de eliminación." 6
        return 1
    fi

    if ! favorites_remove_index "$index"; then app_message "No se pudo eliminar el favorito." 6; return 1; fi
    ui_sync_selection
    if player_is_running && [[ "$PLAYER_URL" == "$url" ]]; then
        app_message "Quitada de favoritos; sigue sonando: $name" 5
    else
        app_message "Favorito eliminado: $name" 5
    fi
}

app_search_catalog() {
    local status=0

    # El buscador integrado forma parte de la propia TUI y no necesita limpiar
    # la pantalla para entrar/salir. El fallback fzf sí necesita cederle la
    # terminal al proceso externo, por lo que conserva suspend/resume.
    if [[ "${KEILA_FZF_SEARCH:-0}" == '1' ]]; then
        ui_suspend
        stations_select_fzf || status=$?
        ui_resume
    else
        stations_select_fzf || status=$?
    fi

    if ((status != 0)); then
        if [[ -n "$CATALOG_PID" && ${#SEARCH_NAMES[@]} == 0 ]]; then
            app_message 'Cargando emisoras…' 3
        else
            app_message "Búsqueda cancelada." 3
        fi
        return 0
    fi
    app_play "$SELECTED_NAME" "$SELECTED_URL"
}

app_update_catalog() {
    catalog_start force || { app_message 'No se pudo iniciar la actualización.' 5; return 1; }
    app_message 'Actualizando catálogo de Radio Browser…' 4
}

app_poll_player() {
    alarm_tick && return 0
    if [[ -n "${PLAYER_PID:-}" ]] && ! player_is_running; then
        local was_recording=$RECORDING_ACTIVE was_paused=${PLAYER_PAUSED:-0} exit_status='?'
        if player_collect_exit_status; then exit_status="${PLAYER_LAST_EXIT_STATUS:-?}"; fi
        if ((was_recording)); then
            local saved_file
            saved_file=$(recording_filename)
            if recording_finalize_after_player_exit; then
                app_message "mpv se detuvo; grabación recuperada: $saved_file ($(recording_size_human))." 9
            else
                app_message "mpv se detuvo (código $exit_status) y la grabación quedó incompleta." 9
            fi
        else
            # Si la emisora ya reprodujo audio, la capa de reconexión mostrará
            # el motivo y el intento en este mismo ciclo. Evitamos enseñar
            # antes un error genérico que parpadea y sobrescribe ese estado.
            if ! (( ${APP_RECONNECT_ELIGIBLE:-0} && was_paused == 0 )); then
                app_message "La reproducción se detuvo inesperadamente (mpv: código $exit_status)." 9
            fi
        fi
        return 0
    fi

    player_is_running || return 1
    local changed=1 was_ready=$PLAYER_INFO_READY was_buffering=$PLAYER_BUFFERING
    local track_rows_before=0 track_rows_after=0 track_changed=1
    if declare -F track_history_visible_count >/dev/null 2>&1; then
        track_rows_before=$(track_history_visible_count)
    fi
    if player_refresh_info; then
        changed=0
        if track_history_observe >/dev/null 2>&1; then track_changed=0; fi
        if declare -F track_history_visible_count >/dev/null 2>&1; then
            track_rows_after=$(track_history_visible_count)
        fi
        if ((!was_ready && PLAYER_INFO_READY)); then
            app_message "Reproduciendo: $PLAYER_NAME" 3
        elif ((!was_buffering && PLAYER_BUFFERING)); then
            app_message "Esperando datos del stream..." 5
        elif ((was_buffering && !PLAYER_BUFFERING && PLAYER_INFO_READY)); then
            app_message "Reproducción reanudada." 3
        elif ((was_ready == PLAYER_INFO_READY && was_buffering == PLAYER_BUFFERING)); then
            # Un cambio solo de título/datos técnicos no modifica el layout.
            # Si el modo actual no permite dibujo parcial, conserva el completo.
            if ((track_changed == 0 && track_rows_after != track_rows_before)); then
                changed=0
            elif ui_draw_player_info_only; then
                changed=1
            fi
        fi
    fi
    if history_observe; then changed=0; fi
    local spectrum_status="$SPECTRUM_ENABLED:$SPECTRUM_AVAILABLE"
    if spectrum_tick; then
        if [[ "$spectrum_status" != "$SPECTRUM_ENABLED:$SPECTRUM_AVAILABLE" ]]; then
            changed=0
        elif ((changed != 0)); then
            ui_draw_spectrum_only || changed=0
        fi
    fi
    if ((SPECTRUM_NOTICE_PENDING)); then
        app_message "Analizador no disponible: ${SPECTRUM_ERROR:-error de captura}" 7
        SPECTRUM_NOTICE_PENDING=0
        changed=0
    fi
    if recording_tick_changed; then changed=0; fi
    return "$changed"
}

app_handle_key() {
    local key="$1" status=0
    case "$key" in
        ',') app_preferences_menu settings; return 0 ;;
        '?') app_preferences_menu help; return 0 ;;
        ';') app_pending_menu; return 0 ;;
        D)
            app_status_screen || status=$?
            ((status == 2)) && return 2
            return 0
            ;;
    esac
    preferences_translate_key "$key"
    key=$PREF_TRANSLATED

    # Cualquier acción distinta de las dos rutas de borrado invalida una
    # confirmación pendiente. Añadir con F también la limpia dentro de la acción.
    case "$key" in
        x|X) ;;
        *) favorites_confirm_clear ;;
    esac

    case "$key" in
        [0-9]) app_play_favorite_preset "$key" || true ;;
        w|W) ui_move_selection -1 || true ;;
        s|S) ui_move_selection 1 || true ;;
        a|A) app_change_volume "$((-KEILA_VOLUME_STEP))" ;;
        d) app_change_volume "$KEILA_VOLUME_STEP" ;;
        p|P) app_toggle_pause || true ;;
        m|M) app_toggle_mute || true ;;
        l|L) app_edit_alarm || true ;;
        f|F) ui_select_emisoras || true ;;
        r|R) ui_select_recientes || true ;;
        c|C) app_edit_label || true ;;
        g|G) app_toggle_recording || true ;;
        x|X) if ((UI_SELECTED_INDEX >= ${#FAVORITE_NAMES[@]})); then app_toggle_selected_recent_favorite || true; else app_toggle_favorite || true; fi ;;
        j|J) app_move_selected_favorite 1 || true ;;
        k|K) app_move_selected_favorite -1 || true ;;
        b|B) app_search_catalog || true ;;
        u|U) app_update_catalog || true ;;
        z|Z) app_edit_equalizer || true ;;
        v|V) app_toggle_spectrum || true ;;
        h|H) app_preferences_menu help ;;
        o|O) app_options_menu || true ;;
        q|Q) app_message "Hasta luego." 0; return 2 ;;
        *) return 1 ;;
    esac
    return 0
}

app_loop() {
    input_init
    ui_enter
    catalog_start || true
    pending_scan_start || true
    ui_draw
    while true; do
        if ! input_read; then return 0; fi
        local redraw=0

        case "$INPUT_EVENT" in
            TICK)
                favorites_confirm_expire >/dev/null 2>&1 || true
                ;;
            UP|DOWN|LEFT|RIGHT|HOME|END|PAGE_UP|PAGE_DOWN|ENTER|ESC)
                favorites_confirm_clear
                ;;
        esac

        case "$INPUT_EVENT" in
            TICK) catalog_poll && redraw=1; app_poll_player && redraw=1; ui_message_tick && redraw=1; pending_scan_poll && redraw=1 ;;
            RESIZE) redraw=1 ;;
            ESC) if ((UI_HELP_VISIBLE)); then ui_toggle_help; redraw=1; fi ;;
            UP) ui_move_selection -1 || true; redraw=1 ;;
            DOWN) ui_move_selection 1 || true; redraw=1 ;;
            LEFT) app_change_volume "$((-KEILA_VOLUME_STEP))"; redraw=1 ;;
            RIGHT) app_change_volume "$KEILA_VOLUME_STEP"; redraw=1 ;;
            HOME) ui_select_first || true; redraw=1 ;;
            END) ui_select_last || true; redraw=1 ;;
            PAGE_UP) ui_move_selection -5 || true; redraw=1 ;;
            PAGE_DOWN) ui_move_selection 5 || true; redraw=1 ;;
            ENTER) app_play_selected || true; redraw=1 ;;
            KEY)
                app_handle_key "$INPUT_KEY"
                local key_status=$?
                if ((key_status == 2)); then ui_draw; return 0; elif ((key_status == 0)); then redraw=1; fi
                ;;
        esac
        ((redraw)) && ui_draw
    done
}

main() {
    case "${1:-}" in
        --version)
            printf 'Keila Radio Player %s\n' "$KEILA_VERSION"
            return 0
            ;;
        --check)
            diagnostics_run "$BASE_DIR"
            return $?
            ;;
        --check-update)
            update_check
            return $?
            ;;
        --update)
            update_install "$BASE_DIR"
            return $?
            ;;
        --catalog-status)
            app_init_catalog_data || return 1
            stations_catalog_status
            return $?
            ;;
        --catalog-rebuild)
            app_init_catalog_data || return 1
            stations_rebuild_tsv || return 1
            stations_catalog_status
            return 0
            ;;
        --catalog-update)
            app_init_catalog_data || return 1
            stations_update_catalog || return 1
            stations_catalog_status
            return 0
            ;;
        --backup)
            backup_create "${2:-}"
            return $?
            ;;
        --restore)
            if [[ -z "${2:-}" ]]; then
                printf 'Uso: %s --restore archivo.tar.gz\n' "$0" >&2
                return 2
            fi
            backup_restore "$2"
            return $?
            ;;
        --*)
            printf 'Opción desconocida: %s\n' "$1" >&2
            printf 'Opciones: --version, --check, --check-update, --update, --catalog-status, --catalog-rebuild, --catalog-update, --backup, --restore\n' >&2
            return 2
            ;;
    esac

    deps_ensure || exit 1
    app_init_data || exit 1
    player_require_dependencies || exit 1
    ui_require_dependencies || exit 1
    session_log_init || true
    ui_select_url "$STATE_LAST_URL" >/dev/null 2>&1 || true

    local station_url="${1:-}"
    local station_name="${2:-Stream de prueba}"
    if [[ -n "$station_url" ]]; then
        app_play "$station_name" "$station_url" || die "No se pudo iniciar mpv"
    elif ((PREF_AUTOPLAY)) && [[ -n "$STATE_LAST_URL" ]]; then
        app_play "$STATE_LAST_NAME" "$STATE_LAST_URL" || true
    elif [[ -n "$STATE_LAST_NAME" ]]; then
        app_message "Última emisora: $STATE_LAST_NAME" 7
    else
        app_message "W/S o flechas para elegir un favorito; B busca en Radio Browser." 8
    fi
    if [[ -n "${DATA_RECOVERY_NOTICE:-}" ]]; then app_message "$DATA_RECOVERY_NOTICE" 20; fi
    app_loop
}

main "$@"
