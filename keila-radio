source "$BASE_DIR/lib/ui-responsive.sh"
# shellcheck source=lib/ui-safe-width.sh
source "$BASE_DIR/lib/ui-safe-width.sh"

# shellcheck source=lib/catalog-startup.sh
source "$BASE_DIR/lib/catalog-startup.sh"
# shellcheck source=lib/label-editor.sh
source "$BASE_DIR/lib/label-editor.sh"
# shellcheck source=lib/equalizer-editor.sh
source "$BASE_DIR/lib/equalizer-editor.sh"
