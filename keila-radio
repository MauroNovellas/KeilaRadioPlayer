#!/usr/bin/env bash

set -uo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LEGACY_FAVORITES_FILE="$BASE_DIR/emisorasFavoritas.txt"
RECORDINGS_DIR="$BASE_DIR/grabaciones"

# shellcheck source=lib/deps.sh
source "$BASE_DIR/lib/deps.sh"
# shellcheck source=lib/config.sh
source "$BASE_DIR/lib/config.sh"
# shellcheck source=lib/state.sh
source "$BASE_DIR/lib/state.sh"
# shellcheck source=lib/favorites.sh
source "$BASE_DIR/lib/favorites.sh"
# shellcheck source=lib/stations.sh
source "$BASE_DIR/lib/stations.sh"
# shellcheck source=lib/player.sh
source "$BASE_DIR/lib/player.sh"
# shellcheck source=lib/recording.sh
source "$BASE_DIR/lib/recording.sh"
# shellcheck source=lib/input.sh
source "$BASE_DIR/lib/input.sh"
# shellcheck source=lib/ui.sh
source "$BASE_DIR/lib/ui.sh"

cleanup() {
    recording_stop >/dev/null 2>&1 || true
    input_shutdown >/dev/null 2>&1 || true
    player_stop >/dev/null 2>&1 || true
    ui_leave >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

save_player_state() {
    STATE_VOLUME="$PLAYER_VOLUME"

    if [[ -n "${PLAYER_URL:-}" ]]; then
        STATE_LAST_NAME="$PLAYER_NAME"
        STATE_LAST_URL="$PLAYER_URL"
    fi

    state_save
}

app_play() {
    local name="$1"
    local url="$2"

    # Cambiar de emisora cierra primero cualquier grabación activa para que el
    # fichero quede finalizado antes de reemplazar el stream de mpv.
    if ((RECORDING_ACTIVE)); then
        recording_stop >/dev/null 2>&1 || true
    fi

    if ! player_start "$name" "$url"; then
        UI_MESSAGE="No se pudo iniciar la emisora: $name"
        return 1
    fi

    save_player_state >/dev/null 2>&1 || true
    UI_MESSAGE="Conectando: $name"
    return 0
}

app_play_selected() {
    favorites_load
    ui_sync_selection

    if ((${#FAVORITE_NAMES[@]} == 0)); then
        UI_MESSAGE="No tienes favoritos. Pulsa B para buscar una emisora."
        return 1
    fi

    local name="${FAVORITE_NAMES[$UI_SELECTED_INDEX]}"
    local url="${FAVORITE_URLS[$UI_SELECTED_INDEX]}"
    app_play "$name" "$url"
}

app_change_volume() {
    local delta="$1"

    if player_change_volume "$delta"; then
        save_player_state >/dev/null 2>&1 || true
        UI_MESSAGE="Volumen: ${PLAYER_VOLUME}%"
    else
        UI_MESSAGE="No se pudo cambiar el volumen."
    fi
}

app_toggle_pause() {
    if ! player_is_running; then
        UI_MESSAGE="No hay ninguna emisora en reproducción."
        return 1
    fi

    if player_toggle_pause; then
        if ((PLAYER_PAUSED)); then
            UI_MESSAGE="Reproducción pausada."
        else
            UI_MESSAGE="Reproducción reanudada."
        fi
    else
        UI_MESSAGE="No se pudo cambiar la pausa."
        return 1
    fi
}

app_toggle_recording() {
    if ((RECORDING_ACTIVE)); then
        local saved_file
        saved_file=$(recording_filename)

        if recording_stop; then
            UI_MESSAGE="Grabación guardada: $saved_file"
            return 0
        fi

        UI_MESSAGE="La grabación se detuvo, pero mpv informó de un error al cerrarla."
        return 1
    fi

    if ! player_is_running; then
        UI_MESSAGE="No hay ninguna emisora en reproducción para grabar."
        return 1
    fi

    if recording_start "$PLAYER_NAME"; then
        UI_MESSAGE="Grabando: $(recording_filename)"
        return 0
    fi

    UI_MESSAGE="No se pudo iniciar la grabación."
    return 1
}

app_toggle_favorite() {
    if ! player_is_running; then
        UI_MESSAGE="No hay ninguna emisora en reproducción."
        return 1
    fi

    favorites_load

    if ! favorites_toggle "$PLAYER_NAME" "$PLAYER_URL"; then
        UI_MESSAGE="No se pudo modificar favoritos."
        return 1
    fi

    case "${FAVORITES_TOGGLE_ACTION:-}" in
        added)
            UI_MESSAGE="Añadida a favoritos: $PLAYER_NAME"
            ui_select_url "$PLAYER_URL" >/dev/null 2>&1 || true
            ;;
        removed)
            UI_MESSAGE="Eliminada de favoritos: $PLAYER_NAME"
            ui_sync_selection
            ;;
    esac
}

app_move_selected_favorite() {
    local delta="$1"

    favorites_load
    ui_sync_selection

    local count=${#FAVORITE_NAMES[@]}
    if ((count == 0)); then
        UI_MESSAGE="No tienes favoritos para reordenar."
        return 1
    fi

    local index=$UI_SELECTED_INDEX
    local target=$((index + delta))
    local name="${FAVORITE_NAMES[$index]}"

    if ((target < 0 || target >= count)); then
        if ((delta < 0)); then
            UI_MESSAGE="Ese favorito ya está arriba del todo."
        else
            UI_MESSAGE="Ese favorito ya está abajo del todo."
        fi
        return 1
    fi

    if favorites_move "$index" "$delta"; then
        UI_SELECTED_INDEX=$target
        ui_sync_selection
        UI_MESSAGE="Nuevo orden guardado: $name"
        return 0
    fi

    UI_MESSAGE="No se pudo reordenar el favorito."
    return 1
}

app_remove_selected_favorite() {
    favorites_load
    ui_sync_selection

    if ((${#FAVORITE_NAMES[@]} == 0)); then
        UI_MESSAGE="No tienes favoritos para eliminar."
        return 1
    fi

    local index=$UI_SELECTED_INDEX
    local name="${FAVORITE_NAMES[$index]}"
    local url="${FAVORITE_URLS[$index]}"

    if ! favorites_remove_index "$index"; then
        UI_MESSAGE="No se pudo eliminar el favorito."
        return 1
    fi

    ui_sync_selection

    if player_is_running && [[ "$PLAYER_URL" == "$url" ]]; then
        UI_MESSAGE="Quitada de favoritos; sigue sonando: $name"
    else
        UI_MESSAGE="Favorito eliminado: $name"
    fi
}

app_search_catalog() {
    ui_suspend

    local status=0
    stations_select_fzf || status=$?

    ui_resume

    if ((status != 0)); then
        UI_MESSAGE="Búsqueda cancelada."
        return 0
    fi

    app_play "$SELECTED_NAME" "$SELECTED_URL"
}

app_update_catalog() {
    ui_suspend

    local status=0
    stations_update_catalog || status=$?

    ui_resume

    if ((status == 0)); then
        UI_MESSAGE="Catálogo de TDTChannels actualizado."
    else
        UI_MESSAGE="No se pudo actualizar el catálogo."
    fi
}

# Comprueba tanto la vida del proceso como los metadatos técnicos del stream.
# Devuelve 0 solo si hay un cambio que justifique redibujar la TUI.
app_poll_player() {
    if [[ -n "${PLAYER_PID:-}" ]] && ! player_is_running; then
        local was_recording=$RECORDING_ACTIVE

        PLAYER_PID=""
        PLAYER_PAUSED=0
        player_reset_info
        recording_reset

        if ((was_recording)); then
            UI_MESSAGE="La reproducción y la grabación se han detenido."
        else
            UI_MESSAGE="La reproducción se ha detenido."
        fi
        return 0
    fi

    player_is_running || return 1

    local was_ready=$PLAYER_INFO_READY
    local was_buffering=$PLAYER_BUFFERING

    if player_refresh_info; then
        if ((!was_ready && PLAYER_INFO_READY)); then
            UI_MESSAGE="Reproduciendo: $PLAYER_NAME"
        elif ((!was_buffering && PLAYER_BUFFERING)); then
            UI_MESSAGE="Esperando datos del stream..."
        elif ((was_buffering && !PLAYER_BUFFERING && PLAYER_INFO_READY)); then
            UI_MESSAGE="Reproducción reanudada."
        fi
        return 0
    fi

    return 1
}

app_handle_key() {
    local key="$1"

    case "$key" in
        w|W)
            ui_move_selection -1 || true
            ;;
        s|S)
            ui_move_selection 1 || true
            ;;
        a|A)
            app_change_volume -5
            ;;
        d|D)
            app_change_volume 5
            ;;
        p|P)
            app_toggle_pause || true
            ;;
        r|R)
            app_toggle_recording || true
            ;;
        f|F)
            app_toggle_favorite || true
            ;;
        j|J)
            app_move_selected_favorite 1 || true
            ;;
        k|K)
            app_move_selected_favorite -1 || true
            ;;
        x|X)
            app_remove_selected_favorite || true
            ;;
        b|B)
            app_search_catalog || true
            ;;
        u|U)
            app_update_catalog || true
            ;;
        q|Q)
            UI_MESSAGE="Hasta luego."
            return 2
            ;;
        *)
            return 1
            ;;
    esac

    return 0
}

app_loop() {
    input_init
    ui_enter
    ui_draw

    while true; do
        if ! input_read; then
            return 0
        fi

        local redraw=0

        case "$INPUT_EVENT" in
            TICK)
                app_poll_player && redraw=1
                ;;
            RESIZE)
                redraw=1
                ;;
            UP)
                ui_move_selection -1 || true
                redraw=1
                ;;
            DOWN)
                ui_move_selection 1 || true
                redraw=1
                ;;
            LEFT)
                app_change_volume -5
                redraw=1
                ;;
            RIGHT)
                app_change_volume 5
                redraw=1
                ;;
            HOME)
                ui_select_first || true
                redraw=1
                ;;
            END)
                ui_select_last || true
                redraw=1
                ;;
            PAGE_UP)
                ui_move_selection -5 || true
                redraw=1
                ;;
            PAGE_DOWN)
                ui_move_selection 5 || true
                redraw=1
                ;;
            ENTER)
                app_play_selected || true
                redraw=1
                ;;
            KEY)
                app_handle_key "$INPUT_KEY"
                local key_status=$?

                if ((key_status == 2)); then
                    ui_draw
                    return 0
                elif ((key_status == 0)); then
                    redraw=1
                fi
                ;;
        esac

        ((redraw)) && ui_draw
    done
}

main() {
    # Keila es actualmente una herramienta personal: si falta una dependencia,
    # se instala automáticamente antes de iniciar la interfaz.
    deps_ensure || exit 1

    keila_init_paths
    favorites_init "$LEGACY_FAVORITES_FILE"
    favorites_load
    state_load

    if ! recording_init "$RECORDINGS_DIR"; then
        die "No se pudo crear la carpeta de grabaciones: $RECORDINGS_DIR"
    fi

    PLAYER_VOLUME="$STATE_VOLUME"

    # Comprobaciones de seguridad después del bootstrap automático.
    player_require_dependencies || exit 1
    ui_require_dependencies || exit 1

    ui_select_url "$STATE_LAST_URL" >/dev/null 2>&1 || true

    local station_url="${1:-}"
    local station_name="${2:-Stream de prueba}"

    if [[ -n "$station_url" ]]; then
        app_play "$station_name" "$station_url" || die "No se pudo iniciar mpv"
    elif [[ -n "$STATE_LAST_NAME" ]]; then
        UI_MESSAGE="Última emisora: $STATE_LAST_NAME"
    else
        UI_MESSAGE="W/S o flechas para elegir un favorito; B busca en TDTChannels."
    fi

    app_loop
}

main "$@"
